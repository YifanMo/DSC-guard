      "name": "Ploutos Money USDC oracle misconfiguration",
      "chain": "ethereum",
      "chain_id": 1,
      "failure_class": "feed_binding_failure",
      "semantic_dimension": "identity_mismatch",
      "oracle_consumption_layer": "consumer_asset_feed_mapping",
      "definition": "The protocol binds a collateral asset to the wrong price source.",
      "trigger_event": "ORACLE_FEED_SET",
      "impact_events": [
        "SUPPLY",
        "BORROW"
      ],
      "violated_constraints": [
        "USDC_FEED_MUST_BE_USDC_USD"
      ],
      "expected_behavior": "USDC collateral should be valued through a USDC/USD feed.",
      "actual_behavior": "USDC collateral was valued through a BTC/USD feed.",
      "chainlink_answerupdated_sufficient": false,
      "collection_mode": "known_tx_receipts_only",
      "api_cost_budget": {
        "rpc_receipts_max": 2,
        "dune_queries_max": 0,
        "etherscan_source_requests_max": 2
      },
      "artifacts": {
        "trace": "artifacts/log_trace/ploutos.jsonl",
        "evidence": "results/ploutos_evidence.json",
        "report": "results/ploutos_detection.md"
      }
    },
