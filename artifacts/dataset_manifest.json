{
  "dataset_name": "Oracle-Consumption Failure Evidence Dataset",
  "paper_scope": "Price-oracle consumption failures in EVM lending protocols",
  "scope_summary": "Historical evidence for EVM lending incidents where a protocol consumes price-oracle data with incorrect identity, transformation, or freshness semantics when computing collateral value, borrow capacity, or liquidation eligibility.",
  "included_failure_classes": [
    "feed_binding_failure",
    "price_semantics_mismatch",
    "price_composition_failure",
    "freshness_handling_failure"
  ],
  "excluded_categories": [
    "general_dex_oracle_price_manipulation",
    "flash_loan_manipulation_of_amm_spot_or_twap_prices",
    "randomness_or_event_resolution_oracles",
    "cross_chain_bridge_oracle_failures",
    "pure_governance_attacks_unrelated_to_oracle_valuation",
    "non_evm_incidents",
    "unknown_incident_discovery_by_full_chain_scanning"
  ],
  "cost_control_policy": {
    "default_mode": "local_artifacts_first",
    "broad_scans": "disabled",
    "rpc_usage": "only known transaction receipts or missing-field validation",
    "dune_usage": "reuse materialized query artifacts unless explicitly refreshing a locator",
    "api_keys": "read from .env and never written to artifacts"
  },
  "broad_search_extension": {
    "design": "seed_evaluation_set_plus_rule_based_remote_search_to_minimal_evidence_materialization",
    "rules": "artifacts/broad_search/rules.json",
    "sql_templates": "artifacts/broad_search/sql/",
    "strategy_report": "results/broad_search_strategy.md",
    "default_action": "render_sql_only_no_paid_query_execution",
    "seed_candidates": "artifacts/broad_search/seed_candidates.jsonl",
    "local_materialization_policy": "seed rows are already materialized; remote candidates download only minimal A_replayable plus logically eligible B_high_confidence_incomplete evidence slices after evidence-closure triage gates; no top-k, weighted score, or amount-based cutoff is used"
  },
  "cases": [
    {
